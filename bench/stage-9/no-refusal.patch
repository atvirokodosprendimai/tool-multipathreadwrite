+// stage9Log is the Stage 9 bench build's kept log (ADR-211 Decision 3): one JSON
+// object per line for each exposed hunk of a landed write, appended to
+// stage9-exposed.jsonl in the parent of $XDG_STATE_HOME, which the bench sets to
+// <scratch>/state. A write with no exposed hunk touches nothing, so the build acts
+// as the other does until a write the other would refuse. A failure leaves the
+// write's result as it was and adds one stderr line after it.
+func stage9Log(res apply.Result) {
+	if len(res.Exposed) == 0 {
+		return
+	}
+	if err := stage9Append(res.Exposed); err != nil {
+		fmt.Fprintf(os.Stderr, "mrw: stage9 log: %v\n", err)
+	}
+}
+
+func stage9Append(events []apply.Exposed) (err error) {
+	home := os.Getenv("XDG_STATE_HOME")
+	if home == "" || !filepath.IsAbs(home) {
+		return errors.New("XDG_STATE_HOME is unset or not absolute")
+	}
+	path := filepath.Join(filepath.Dir(filepath.Clean(home)), "stage9-exposed.jsonl")
+	// apply reports only hunks that landed as ok (commitFailed), so res.Exposed
+	// needs no second filter by file.
+	var buf []byte
+	for _, e := range events {
+		b, merr := json.Marshal(e)
+		if merr != nil {
+			return merr
+		}
+		buf = append(append(buf, b...), '\n')
+	}
+	// Only a regular file or an absent path is opened, and without blocking: a
+	// FIFO with no reader must not hang a landed write that holds the lock.
+	if fi, lerr := os.Lstat(path); lerr == nil && !fi.Mode().IsRegular() {
+		return fmt.Errorf("%s is not a regular file", path)
+	}
+	f, oerr := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY|syscall.O_NONBLOCK, 0o600)
+	if oerr != nil {
+		return oerr
+	}
+	defer func() {
+		if cerr := f.Close(); err == nil {
+			err = cerr
+		}
+	}()
+	// The path may have been swapped since the Lstat: write only to what was opened.
+	if fi, serr := f.Stat(); serr != nil || !fi.Mode().IsRegular() {
+		return fmt.Errorf("%s is not a regular file", path)
+	}
+	_, err = f.Write(buf)
+	return err
+}

+// stage9Log is the Stage 9 bench build's kept log: one JSON object per line for
+// each exposed hunk of a file that landed, appended to stage9-exposed.jsonl
+// under the state home, which the first landed write of any kind creates. A
+// failure here is silent: it changes nothing a caller sees.
+func stage9Log(res apply.Result) {
+	base, err := state.Base()
+	if err != nil {
+		return
+	}
+	written := map[string]bool{}
+	for _, f := range res.Files {
+		if f.Written {
+			written[f.Path] = true
+		}
+	}
+	var buf []byte
+	for _, e := range res.Exposed {
+		if !written[e.Path] {
+			continue
+		}
+		if b, err := json.Marshal(e); err == nil {
+			buf = append(append(buf, b...), '\n')
+		}
+	}
+	if os.MkdirAll(base, 0o700) != nil {
+		return
+	}
+	f, err := os.OpenFile(filepath.Join(base, "stage9-exposed.jsonl"), os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o600)
+	if err != nil {
+		return
+	}
+	_, _ = f.Write(buf)
+	_ = f.Close()
+}

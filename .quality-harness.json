{
  "check": "go test ./...",
  "scoped_check": "go test {packages}",
  "timeout_seconds": 300,
  "tail_lines": 30,
  "steps": {
    "static": "./scripts/static.sh",
    "brew-tap": "test -f .github/workflows/brew-tap.yml && grep -q \"SHA256SUMS.txt\" .github/workflows/brew-tap.yml && grep -q \"PUSH_TOKEN\" .github/workflows/brew-tap.yml && grep -q \"atvirokodosprendimai/homebrew-tap\" .github/workflows/brew-tap.yml"
  }
}
